# Copy to .env. Read by Django, runserver.py and docker-compose.yml.
# Defaults are for running everything with Docker (docker compose up): hosts are the compose service names.

DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Service Ports (also the ports published on your machine)
SERVICE_HOST=0.0.0.0
STORE_SERVICE_PORT=8000
AUTH_SERVICE_PORT=8001
PRODUCT_SERVICE_PORT=8002
CART_SERVICE_PORT=8003
ORDER_SERVICE_PORT=8004

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=16379 # I had a clash with another process using port 6379 so I made it 16379 💀

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=secretpassword
EVENTS_EXCHANGE=events
